{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {

    },
    "— %@" : {
      "comment" : "A sublabel within the checkout view that shows the author of a saved quote. The argument is the author of the saved quote.",
      "isCommentAutoGenerated" : true
    },
    "\"%@\"" : {
      "comment" : "A quote text displayed in the list. The text is wrapped in double quotes.",
      "isCommentAutoGenerated" : true
    },
    "%@ %lld" : {
      "comment" : "A label that shows the total number of prayers to be recited.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A text label showing the current count of prayers recited.",
      "isCommentAutoGenerated" : true
    },
    "%lld %@" : {
      "comment" : "A caption displaying the current streak of a shared habit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld %2$@"
          }
        }
      }
    },
    "%lld%%" : {
      "comment" : "A text label displaying the percentage of completed habits out of a total. The argument is the percentage of habits that have been completed.",
      "isCommentAutoGenerated" : true
    },
    "• %@" : {

    },
    "0" : {
      "comment" : "The accessibility value for the share button, indicating that the share flow has not yet triggered.",
      "isCommentAutoGenerated" : true
    },
    "1" : {
      "comment" : "A toggle that indicates whether the share button has been triggered.",
      "isCommentAutoGenerated" : true
    },
    "Adat" : {

    },
    "about.cofounder_developer.role" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Co-founder & Developer" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Бірлескен құрылтайшы және әзірлеуші" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сооснователь и разработчик" } }
      }
    },
    "about.cofounder_developer.name" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Alimkhan Yergebayev" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Әлімхан Ергебай" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Алимхан Ергебаев" } }
      }
    },
    "about.description" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Adat keeps daily habits and dhikr simple. Your progress is saved on this device first, so you can keep tracking without an account or internet. Sign in when you want backup, groups, and sync across devices." } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Adat күнделікті әдеттер мен зікірді белгілеуді жеңілдетеді. Ілгерілеуіңіз алдымен осы құрылғыда сақталады, сондықтан аккаунтсыз және интернетсіз де жалғастыра аласыз. Сақтық көшірме, топтар және құрылғылар арасында синхрондау қажет болса, аккаунтқа кіріңіз." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Adat помогает без лишнего отмечать ежедневные привычки и зикр. Прогресс сначала сохраняется на этом устройстве, поэтому приложением можно пользоваться без аккаунта и интернета. Войдите, если нужны резервная копия, группы и синхронизация между устройствами." } }
      }
    },
    "about.founder.name" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Arystan Almasuly" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Арыстан Алмасұлы" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Арыстан Алмасулы" } }
      }
    },
    "about.founder.role" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Founder" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Құрылтайшы" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Основатель" } }
      }
    },
    "about.made_by" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Made by" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Авторлар" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Авторы" } }
