        "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld of 3" } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "3 ішінен %lld" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%lld из 3" } }
      }
    },
    "onboarding.templates.subtitle" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose 1–3 habits for your first day. You can change them anytime." } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Алғашқы күніңізге 1–3 әдет таңдаңыз. Оларды кез келген уақытта өзгерте аласыз." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите 1–3 привычки на первый день. Их можно изменить в любое время." } }
      }
    },
    "onboarding.welcome.private_start" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Start privately. No account or notification permission required." } },
        "kk" : { "stringUnit" : { "state" : "translated", "value" : "Жеке бастаңыз. Аккаунт пен хабарландыру рұқсаты қажет емес." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Начните приватно. Аккаунт и разрешение на уведомления не нужны." } }
      }
