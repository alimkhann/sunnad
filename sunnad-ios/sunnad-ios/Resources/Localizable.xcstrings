    },
    "— %@" : {
      "comment" : "A sublabel within the checkout view that shows the author of a saved quote. The argument is the author of the saved quote.",
      "isCommentAutoGenerated" : true
    },
    "\"%@\"" : {
      "comment" : "A quote text displayed in the list. The text is wrapped in double quotes.",
      "isCommentAutoGenerated" : true
    },
    "%@ %lld" : {
      "comment" : "A label that shows the total number of prayers to be recited.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$lld"
          }
        }
      }
    },
    "%lld" : {
      "comment" : "A text label showing the current count of prayers recited.",
      "isCommentAutoGenerated" : true
    },
    "%lld %@" : {
      "comment" : "A caption displaying the current streak of a shared habit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld %2$@"
          }
        }
      }
    },
    "%lld/%lld %@" : {
      "comment" : "A label showing how many of a habit the user has completed today out of the total number of times it is due.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld/%2$lld %3$@"
          }
        }
      }
    },
    "%lld%%" : {
      "comment" : "A text label displaying the percentage of completed habits out of a total. The argument is the percentage of habits that have been completed.",
      "isCommentAutoGenerated" : true
    },
